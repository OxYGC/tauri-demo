{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri Demo",
  "version": "0.0.1",
  "identifier": "com.tauri.demo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tauri Demo",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "plugins": {
    "updater": {
      "dialog": false,
    "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0RjI2RjE1NkIyNzMxNDEKUldSQk1TZHJGVy95Wkc0WHlkaVF6WGs4M0cxS1hxQmRyNWtGVW9XZ0ZtNGUxNDZ0THRWV3duM28K",
      "endpoints": [
        "https://github.com/OxYGC/tauri-demo/releases/latest/download/latest.json",
        "https://raw.githubusercontent.com/OxYGC/web-incubator/refs/heads/main/data-hub/mock/tauri-demo/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
